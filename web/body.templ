package web

import (
	"fmt"

	"github.com/alivehamster/playlist-monitor-go/internal"
)

templ Body(playlists []internal.Playlist) {
	<style>
		*, *::before, *::after { box-sizing: border-box; }
		body { font-family: sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1.25rem; background: #f5f5f5; color: #222; }
		h1 { margin-bottom: 1.5rem; }

		/* Buttons */
		.btn { display: inline-block; padding: 0.5rem 1.1rem; border: none; border-radius: 5px; cursor: pointer; font-size: 0.95rem; font-weight: 500; text-decoration: none; }
		.btn:hover, .btn:focus { text-decoration: none; }
		.btn-primary { background: #0070f3; color: #fff; }
		.btn-primary:hover { background: #005ecb; }
		.btn-run { background: #2f9e44; color: #fff; }
		.btn-run:hover { background: #2b8a3e; }
		.btn-secondary { background: #e0e0e0; color: #333; }
		.btn-secondary:hover { background: #c8c8c8; }
		.btn-danger { background: #e53e3e; color: #fff; }
		.btn-danger:hover { background: #c53030; }

		/* Modal */
		dialog { border: none; border-radius: 10px; padding: 2rem; box-shadow: 0 8px 32px rgba(0,0,0,0.25); min-width: 380px; }
		dialog::backdrop { background: rgba(0,0,0,0.45); }
		dialog h2 { margin-top: 0; margin-bottom: 1.25rem; }
		.dialog-fields { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.25rem; }
		.dialog-fields input[type="text"] { padding: 0.55rem 0.75rem; border: 1px solid #ccc; border-radius: 5px; font-size: 1rem; width: 100%; }
		.dialog-fields input[type="text"]:focus { outline: 2px solid #0070f3; border-color: transparent; }
		.delete-option { display: inline-flex; align-items: center; gap: 0.45rem; width: fit-content; }
		.delete-option input[type="checkbox"] { cursor: pointer; }
		.tooltip-help { position: relative; display: inline-flex; align-items: center; justify-content: center; width: 1.1rem; height: 1.1rem; border-radius: 999px; border: 1px solid #777; color: #555; font-size: 0.75rem; font-weight: 700; cursor: pointer; line-height: 1; }
		.tooltip-text { visibility: hidden; opacity: 0; transition: opacity 0.15s ease; position: absolute; left: 50%; transform: translateX(-50%); bottom: 145%; white-space: nowrap; background: #333; color: #fff; font-size: 0.78rem; font-weight: 500; padding: 0.35rem 0.55rem; border-radius: 4px; z-index: 10; }
		.tooltip-help:hover .tooltip-text,
		.tooltip-help:focus .tooltip-text { visibility: visible; opacity: 1; }
		.dialog-actions { display: flex; gap: 0.6rem; justify-content: flex-end; }

		/* Playlist box */
		.playlist-box { background: #fff; border: 1px solid #ddd; border-radius: 10px; padding: 1.5rem; margin-top: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
		.playlist-box-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
		.playlist-box-header h2 { margin: 0; }
		.playlist-empty { color: #888; font-style: italic; }
		.playlist-item { display: flex; justify-content: space-between; align-items: center; padding: 0.85rem 1rem; border: 1px solid #ececec; border-radius: 7px; margin-bottom: 0.6rem; background: #fafafa; gap: 1rem; }
		.playlist-item:last-child { margin-bottom: 0; }
		.playlist-info { display: flex; flex-direction: column; gap: 0.2rem; overflow: hidden; }
		.playlist-info .url { font-weight: 600; word-break: break-all; }
		.playlist-info .path { font-size: 0.875rem; color: #555; word-break: break-all; }
		.playlist-actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
		.playlist-actions form { margin: 0; }
		.header-actions { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
		.header-actions form { display: flex; align-items: center; margin: 0; }
	</style>
	<h1>YTM Playlist Monitor</h1>
	<div class="header-actions">
		<button class="btn btn-primary" onclick="addPlaylist()">+ Add Playlist</button>
		<form method="POST" action="/run">
			<button type="submit" class="btn btn-run">Run</button>
		</form>
	</div>
	<dialog id="editModal">
		<h2 id="editModalLabel">Edit Playlist</h2>
		<form method="POST" action="/add-playlist">
			<div class="dialog-fields">
				<input type="hidden" id="id" name="index"/>
				<input id="playlist" type="text" name="url" placeholder="Playlist URL" required/>
				<input id="downloadPath" type="text" name="downloadPath" placeholder="Download Path" required/>
				<label class="delete-option">
					<input id="delete" type="checkbox" name="delete" value="true"/>
					Delete
					<span class="tooltip-help" tabindex="0" aria-label="delete songs in folder to match playlist">
						<span class="tooltip-mark">?</span>
						<span class="tooltip-text">Delete songs in folder to match playlist</span>
					</span>
				</label>
			</div>
			<div class="dialog-actions">
				<button type="button" class="btn btn-secondary" onclick="document.getElementById('editModal').close()">Cancel</button>
				<button type="submit" class="btn btn-primary">Save</button>
			</div>
		</form>
	</dialog>
	<dialog id="removeModal">
		<h2>Remove Playlist</h2>
		<p>Are you sure you want to remove this playlist?</p>
		<form method="POST" action="/remove-playlist">
			<input type="hidden" id="removeUrl" name="url"/>
			<div class="dialog-actions">
				<button type="button" class="btn btn-secondary" onclick="document.getElementById('removeModal').close()">Cancel</button>
				<button type="submit" class="btn btn-danger">Remove</button>
			</div>
		</form>
	</dialog>
	@ListPlaylists(playlists)
}

templ ListPlaylists(playlists []internal.Playlist) {
	<div class="playlist-box">
		<div class="playlist-box-header">
			<h2>Playlists</h2>
		</div>
		if len(playlists) == 0 {
			<p class="playlist-empty">No playlists added yet.</p>
		} else {
			for index, playlist := range playlists {
				<div class="playlist-item">
					<div class="playlist-info">
						<span class="url">{ playlist.URL }</span>
						<span class="path">{ playlist.DownloadPath }</span>
						<span class="path">Delete: { fmt.Sprint(playlist.Delete) }</span>
					</div>
					<div class="playlist-actions">
						<a href={ templ.SafeURL(playlist.URL) } target="_blank" rel="noopener noreferrer" class="btn btn-primary">Open</a>
						<button
							type="button"
							class="btn btn-secondary"
							data-index={ fmt.Sprint(index) }
							data-url={ playlist.URL }
							data-path={ playlist.DownloadPath }
							data-delete={ fmt.Sprint(playlist.Delete) }
							onclick="editPlaylist(this)"
						>Edit</button>
						<button type="button" class="btn btn-danger" onclick="removePlaylist(this)" data-url={ playlist.URL }>Remove</button>
					</div>
				</div>
			}
		}
	</div>
	<script>
		function addPlaylist() {
			document.getElementById('id').value = '';
			document.getElementById('editModalLabel').textContent = 'Add Playlist';
			document.getElementById('playlist').value = '';
			document.getElementById('downloadPath').value = '';
			document.getElementById('delete').checked = false;
			document.getElementById('editModal').showModal();
		}

		function editPlaylist(button) {
			document.getElementById('id').value = button.getAttribute('data-index');
			document.getElementById('editModalLabel').textContent = 'Edit Playlist';
			document.getElementById('playlist').value = button.getAttribute('data-url');
			document.getElementById('downloadPath').value = button.getAttribute('data-path');
			document.getElementById('delete').checked = button.getAttribute('data-delete') === 'true';
			document.getElementById('editModal').showModal();
		}

		function removePlaylist(button) {
			document.getElementById('removeUrl').value = button.getAttribute('data-url');
			document.getElementById('removeModal').showModal();
		}
	</script>
}
